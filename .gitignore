# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/out/

# Production build artifacts
/build
/dist

# Environment variables
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Vercel deployment metadata
.vercel

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# Operating System files
.DS_Store
*.pem
Thumbs.db
ehthumbs.db

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Uploaded user files (local uploads)
/public/uploads/*
!/public/uploads/.gitkeep

# Markdown files — Exclude all .md except README.md
*.md
!README.md
!readme.md
!**/README.md
!**/readme.md

# AI Workflows, agents, and IDE directories
.agents/
.gemini/
.claude/
.cursor/
.windsurf/
.system_generated/

